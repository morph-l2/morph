#!/usr/bin/env bash
# Template for env/secrets.env (the real file is git-ignored; never commit it). Easiest way to create it:
#     DEPLOYER_PRIVATE_KEY=0x... scripts/init-secrets.sh        # generates the three other keys for you
# The scripts derive everything else (contract addresses, start block) from the deployment output.

# ---- L1 = public Ethereum Hoodi (chain id 560048) ----
export L1_ETH_RPC="https://rpc.hoodi.ethpandaops.io"
# fallbacks the local l1-proxy switches to on rate limits (comma separated; override with RPC_FALLBACK_URLS)
# export RPC_FALLBACK_URLS="https://0xrpc.io/hoodi,https://ethereum-hoodi-rpc.publicnode.com"
# beacon endpoints: morphnode accepts a comma separated list; gas-price-oracle uses the first one only
export L1_BEACON_RPC="https://beacon.hoodi.ethpandaops.io,https://ethereum-hoodi-beacon-api.publicnode.com"

# ---- private keys (cast wallet new). Never use the public Anvil key. ----
export DEPLOYER_PRIVATE_KEY="<L1 admin: deploys and initialises the contracts; needs ~1.5 Hoodi ETH>"
export SEQUENCER_PRIVATE_KEY="<L2 block signer; registered as the first sequencer in L1Sequencer>"
export BATCH_SUBMITTER_PRIVATE_KEY="<submits batches to the Rollup; funded with 1 ETH by the deployer during deploy-l1.sh>"
export L2_GAS_ORACLE_PRIVATE_KEY="<updates GasPriceOracle on L2; funded on L2 by l2-bootstrap.sh>"
