+// observeBlockSize feeds a received block response into blockSizeEst. Caller
+// must hold pool.mtx.
+func (pool *BlockPool) observeBlockSize(size int) {
+	s := int64(size)
+	if s >= pool.blockSizeEst {
+		pool.blockSizeEst = s
+		return
+	}
+	pool.blockSizeEst -= (pool.blockSizeEst - s) / 64
+}
+
+// peerRequestLimit returns how many requests may be pending on one peer.
+// Caller must hold pool.mtx.
+func (pool *BlockPool) peerRequestLimit() int32 {
+	if pool.blockSizeEst <= 0 {
+		return minPendingRequestsPerPeer
+	}
+	limit := pendingBytesPerPeer / pool.blockSizeEst
+	if limit < minPendingRequestsPerPeer {
+		return minPendingRequestsPerPeer
+	}
+	if limit > maxPendingRequestsPerPeer {
+		return maxPendingRequestsPerPeer
+	}
+	return int32(limit)
+}
+
+// maxRequesters bounds how far ahead of pool.height blocks are requested.
+// Requesters race for free request slots in no particular height order, so a
+// window much wider than the slots can leave the block the pool is waiting for
+// unrequested.
+func (pool *BlockPool) maxRequesters() int {
+	pool.mtx.Lock()
+	defer pool.mtx.Unlock()
+
+	peers := len(pool.peers)
+	if peers == 0 {
+		peers = 1
+	}
+	n := peers * int(pool.peerRequestLimit()) * 3 / 2
+	if n > maxTotalRequesters {
+		return maxTotalRequesters
+	}
+	return n
+}
