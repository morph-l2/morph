+// hedgeRequest asks one more peer for the height the pool is blocked on.
+func (pool *BlockPool) hedgeRequest(height int64, original p2p.ID) (p2p.ID, bool) {
+	pool.mtx.Lock()
+	defer pool.mtx.Unlock()
+	if height != pool.height {
+		return "", false
+	}
+	originalPeer := pool.peers[original]
+	for _, peer := range pool.peers {
+		if peer.id == original || peer.didTimeout || height < peer.base || height > peer.height {
+			continue
+		}
+		if _, dup := peer.hedged[height]; dup {
+			continue
+		}
+		peer.incrPending()
+		peer.hedged[height] = struct{}{}
+		if originalPeer != nil {
+			originalPeer.hedged[height] = struct{}{}
+		}
+		return peer.id, true
+	}
+	return "", false
