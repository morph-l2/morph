# Challenger configuration example.
# Copy the values you need into the environment. Do not commit filled-in secrets.

# L1 RPC and Rollup
CHALLENGER_L1_ETH_RPC=http://127.0.0.1:8545
CHALLENGER_ROLLUP_ADDRESS=0x0000000000000000000000000000000000000000

# HTTP trigger. POST /challenge with {"batchIndex":1,"batchHash":"0x..."}
CHALLENGER_HTTP_HOSTNAME=0.0.0.0
CHALLENGER_HTTP_PORT=8080
CHALLENGER_HTTP_AUTH_TOKEN=
CHALLENGER_RECEIPT_TIMEOUT=2m

# Remote signer. This address must be on the Rollup challenger list.
# Leave EXTERNAL_SIGN unset and set PRIVATE_KEY only for local development.
CHALLENGER_EXTERNAL_SIGN=true
CHALLENGER_EXTERNAL_SIGN_ADDRESS=
CHALLENGER_EXTERNAL_SIGN_APPID=
CHALLENGER_EXTERNAL_SIGN_CHAIN=
CHALLENGER_EXTERNAL_SIGN_URL=
CHALLENGER_EXTERNAL_SIGN_RSA_PRIV=

# Local key, used only when EXTERNAL_SIGN is false.
# CHALLENGER_PRIVATE_KEY=

# Optional EIP-1559 ceilings, in wei.
# CHALLENGER_GAS_FEE_CAP=
# CHALLENGER_GAS_TIP_CAP=

# Metrics
CHALLENGER_METRICS_SERVER_ENABLE=true
CHALLENGER_METRICS_HOSTNAME=0.0.0.0
CHALLENGER_METRICS_PORT=6060

# Logging
CHALLENGER_LOG_LEVEL=info
# CHALLENGER_LOG_FILENAME=/data/logs/challenger/challenger.log
